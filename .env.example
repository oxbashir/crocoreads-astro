# =============================================================================
# CrocoReads — Supabase keys cheat sheet
# =============================================================================
#
# You need exactly 3 values. Ignore everything else in the Supabase dashboard
# (database password, JWT secret, connection strings, etc.).
#
# WHERE TO FIND THEM (Supabase dashboard):
#   Project Settings → API Keys
#   https://supabase.com/dashboard/project/_/settings/api-keys
#
#   Or click "Connect" on your project home — it shows URL + keys together.
#
# -----------------------------------------------------------------------------
# 1) PUBLIC_SUPABASE_URL
# -----------------------------------------------------------------------------
#   Label in dashboard: "Project URL"
#   Looks like:         https://abcdefghijklmnop.supabase.co
#   Also shown under:   Settings → API → Project URL (legacy page)
#
# -----------------------------------------------------------------------------
# 2) PUBLIC_SUPABASE_ANON_KEY   (public / low-privilege — safe in browser)
# -----------------------------------------------------------------------------
#   NEW keys tab:       "Publishable key"     → starts with sb_publishable_
#   Legacy tab:         "anon" / "anon public" → long JWT starting with eyJ...
#
#   Either works. Use ONE of them here.
#
# -----------------------------------------------------------------------------
# 3) SUPABASE_SERVICE_ROLE_KEY  (secret — server only, never in Cloudflare PUBLIC_)
# -----------------------------------------------------------------------------
#   NEW keys tab:       "Secret key"          → starts with sb_secret_
#   Legacy tab:         "service_role"        → long JWT starting with eyJ...
#
#   Either works. Only used locally for `npm run seed`. Do NOT add to Cloudflare
#   unless you run seed from CI (you don't need it for the live website).
#
# =============================================================================
# LOCAL: copy this file to .env and fill in values
# PRODUCTION (Cloudflare Pages): set only #1 and #2 as environment variables
# =============================================================================

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_legacy_anon_jwt

# Local seeding only (npm run seed)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_legacy_service_role_jwt
