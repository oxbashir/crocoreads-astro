# Copy to .env for local dev, or set in Cloudflare Pages → Settings → Environment variables.
# PUBLIC_ prefix is required so Astro can expose URL/anon key to the server runtime.

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — used by npm run seed (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
