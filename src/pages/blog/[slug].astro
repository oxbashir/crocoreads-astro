---
import PostLayout from '../../layouts/PostLayout.astro';
import { getArticleBySlug, getSupabase } from '../../lib/article-service';
import { extractHeadings, renderMarkdown } from '../../lib/markdown';
import { getReadingTime } from '../../utils/readingTime';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) return Astro.redirect('/blog');

const supabase = await getSupabase(Astro);
const article = await getArticleBySlug(supabase, slug);

if (!article) return Astro.redirect('/404');

const readingTime = getReadingTime(article.content);
const headings = extractHeadings(article.content);
const htmlContent = renderMarkdown(article.content);
---

<PostLayout article={article} readingTime={readingTime} headings={headings} htmlContent={htmlContent} />
