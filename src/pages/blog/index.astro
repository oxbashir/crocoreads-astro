---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getPublishedArticles } from '../../lib/articles';
import { SITE } from '../../config/site';

export const prerender = false;

const tag = Astro.url.searchParams.get('tag');
const supabase = createSupabaseServerClient(Astro.cookies);

let posts = await getPublishedArticles(supabase, tag);
let loadError = '';

const pageTitle = tag ? `Articles tagged "${tag}"` : 'Articles';
---

<BaseLayout
  title={`${pageTitle} | ${SITE.name}`}
  description="Browse practical guides on web development, productivity, and modern technology."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">{pageTitle}</h1>
      <p class="mt-3 text-text-muted">
        {tag
          ? `${posts.length} article${posts.length === 1 ? '' : 's'} in this topic.`
          : 'In-depth tutorials and guides written for developers and curious builders.'}
      </p>
    </header>

    {
      loadError && (
        <p class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          {loadError}
        </p>
      )
    }

    {
      posts.length > 0 ? (
        <>
          <div class="mb-10 flex flex-wrap gap-2">
            <a
              href="/blog"
              class:list={[
                'rounded-full px-3 py-1 text-sm font-medium transition',
                !tag ? 'bg-accent text-white' : 'bg-slate-100 text-text-muted hover:bg-slate-200',
              ]}
            >
              All
            </a>
            {[...new Set(posts.flatMap((p) => p.tags))].sort().map((item) => (
              <a
                href={`/blog?tag=${encodeURIComponent(item)}`}
                class:list={[
                  'rounded-full px-3 py-1 text-sm font-medium transition',
                  tag === item
                    ? 'bg-accent text-white'
                    : 'bg-slate-100 text-text-muted hover:bg-slate-200',
                ]}
              >
                {item}
              </a>
            ))}
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((article) => (
              <PostCard article={article} />
            ))}
          </div>
        </>
      ) : (
        <p class="text-text-muted">
          No articles published yet. Sign in to the <a href="/admin/login" class="text-accent hover:underline">admin</a>{' '}
          to create content.
        </p>
      )
    }
  </div>
</BaseLayout>
