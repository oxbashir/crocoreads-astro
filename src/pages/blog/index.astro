---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';

const tag = Astro.url.searchParams.get('tag');

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .filter((post) => !tag || post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

const pageTitle = tag ? `Articles tagged "${tag}"` : 'Articles';
---

<BaseLayout
  title={`${pageTitle} | ${SITE.name}`}
  description="Browse practical guides on web development, productivity, and modern technology."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">{pageTitle}</h1>
      <p class="mt-3 text-text-muted">
        {tag
          ? `${posts.length} article${posts.length === 1 ? '' : 's'} in this topic.`
          : 'In-depth tutorials and guides written for developers and curious builders.'}
      </p>
    </header>

    {
      allTags.length > 0 && (
        <div class="mb-10 flex flex-wrap gap-2">
          <a
            href="/blog"
            class:list={[
              'rounded-full px-3 py-1 text-sm font-medium transition',
              !tag ? 'bg-accent text-white' : 'bg-slate-100 text-text-muted hover:bg-slate-200',
            ]}
          >
            All
          </a>
          {allTags.map((item) => (
            <a
              href={`/blog?tag=${encodeURIComponent(item)}`}
              class:list={[
                'rounded-full px-3 py-1 text-sm font-medium transition',
                tag === item
                  ? 'bg-accent text-white'
                  : 'bg-slate-100 text-text-muted hover:bg-slate-200',
              ]}
            >
              {item}
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <div class="relative">
              <PostCard post={post} />
            </div>
          ))}
        </div>
      ) : (
        <p class="text-text-muted">No articles found. Check back soon.</p>
      )
    }
  </div>
</BaseLayout>
