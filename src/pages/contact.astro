---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config/site';

export const prerender = true;
---

<PageLayout title="Contact" description={`Contact ${SITE.name} for questions, feedback, or partnership inquiries.`}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">Contact us</h1>
    <p class="mt-4 text-lg text-text-muted">
      Have a question, correction, or suggestion? We'd love to hear from you.
    </p>
  </header>

  <div class="prose-content">
    <p>
      Email us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We read every message and typically respond
      within a few business days.
    </p>
    <p>
      For corrections to an article, privacy requests, or AdSense-related inquiries, include the page URL in your
      message so we can help faster.
    </p>
  </div>
</PageLayout>
