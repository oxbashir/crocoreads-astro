---
import { ADSENSE, isAdSlotConfigured } from '../config/site';

interface Props {
  slotId: string;
  format?: 'horizontal' | 'vertical' | 'rectangle';
  label?: string;
}

const { slotId, format = 'horizontal', label = 'Advertisement' } = Astro.props;

const sizeClasses = {
  horizontal: 'min-h-[90px]',
  vertical: 'min-h-[600px]',
  rectangle: 'min-h-[250px]',
};

const showAd = ADSENSE.enabled && isAdSlotConfigured(slotId);
---

{
  showAd && (
    <div class="ad-container my-6 flex justify-center" aria-label={label}>
      <ins
        class="adsbygoogle block w-full"
        style="display:block"
        data-ad-client={ADSENSE.clientId}
        data-ad-slot={slotId}
        data-ad-format={format === 'horizontal' ? 'auto' : format}
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  )
}

{
  !ADSENSE.enabled && (
    <div class="ad-container my-6 flex justify-center" aria-label={label}>
      <div
        class:list={[
          'flex w-full max-w-3xl items-center justify-center rounded-lg border-2 border-dashed border-border bg-slate-50 text-sm text-text-muted',
          sizeClasses[format],
        ]}
      >
        <span>{label} (placeholder)</span>
      </div>
    </div>
  )
}
