---
import { SITE, NAV_LINKS } from '../config/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-surface/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="group flex items-center gap-3">
      <img
        src="/logo.png"
        alt={`${SITE.name} logo`}
        width="40"
        height="40"
        class="h-10 w-10 rounded-full object-cover shadow-sm ring-1 ring-border"
      />
      <div class="leading-tight">
        <span class="block text-lg font-bold text-text group-hover:text-accent">{SITE.name}</span>
        <span class="hidden text-xs text-text-muted sm:block">{SITE.tagline}</span>
      </div>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {
        NAV_LINKS.map(({ href, label }) => {
          const isActive =
            href === '/' ? currentPath === '/' : currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition',
                isActive
                  ? 'bg-accent/10 text-accent'
                  : 'text-text-muted hover:bg-slate-100 hover:text-text',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-border bg-surface text-text [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 w-48 rounded-xl border border-border bg-surface p-2 shadow-lg"
        aria-label="Mobile navigation"
      >
        {
          NAV_LINKS.map(({ href, label }) => (
            <a
              href={href}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-text hover:bg-slate-100"
            >
              {label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
