---
import { formatDate } from '../utils/formatDate';
import type { Article } from '../types/article';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, pub_date, tags, slug, hero_image } = article;
const pubDate = new Date(pub_date);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  {
    hero_image && (
      <img
        src={hero_image}
        alt={title}
        width="400"
        height="225"
        class="h-44 w-full object-cover"
        loading="lazy"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-text-muted">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {
        tags[0] && (
          <>
            <span aria-hidden="true">·</span>
            <span class="rounded-full bg-accent/10 px-2 py-0.5 font-medium text-accent">{tags[0]}</span>
          </>
        )
      }
    </div>
    <h2 class="text-xl font-bold text-text group-hover:text-accent">
      <a href={`/blog/${slug}`} class="before:absolute before:inset-0">
        {title}
      </a>
    </h2>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{description}</p>
    <p class="mt-4 text-sm font-medium text-accent">Read article →</p>
  </div>
</article>
