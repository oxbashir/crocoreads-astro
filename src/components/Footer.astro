---
import { SITE, FOOTER_LINKS } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-text">{SITE.name}</p>
        <p class="mt-2 text-sm text-text-muted">{SITE.tagline}</p>
        <p class="mt-4 text-sm text-text-muted">
          Independent guides on publishing, SEO, and developer tooling — built for readers who ship.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-text">Legal</p>
        <ul class="mt-3 space-y-2">
          {
            FOOTER_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-text-muted transition hover:text-accent">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-text">Connect</p>
        <p class="mt-3 text-sm text-text-muted">
          Questions or feedback?
          <a href="/contact" class="text-accent hover:underline">Get in touch</a>.
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p>Built with Astro. Hosted free on Cloudflare Pages.</p>
    </div>
  </div>
</footer>
